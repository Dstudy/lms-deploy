# =================================================================
# LMS Docker Environment Configuration
# Copy this file to .env and adjust variables as needed
# =================================================================

# MySQL Database Settings
MYSQL_ROOT_PASSWORD=lms_root_password_123
MYSQL_DATABASE=lms_db
MYSQL_PORT=3306

# Backend Settings
BACKEND_PORT=3001
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_12345
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:9002

# Frontend Settings
FRONTEND_PORT=9002
NEXT_PUBLIC_API_URL=http://localhost:3001
